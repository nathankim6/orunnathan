# Supabase connection for the Vite frontend.
# These are the project's PUBLIC (anon / publishable) values, not secrets, but they must
# live here instead of in source files. Lovable keeps the real .env committed; copy this file
# to .env and fill in the values when setting up a fresh checkout.
# Never put a service_role key or any third-party API key in a VITE_* variable.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
